# Docker Compose interpolation
# Replace 127.0.0.1 with the result of: tailscale ip -4
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
JETSON_SSH_KEY_PATH=/home/jetson/.ssh/brin_web_backend
JETSON_KNOWN_HOSTS_PATH=/home/jetson/.ssh/brin_web_known_hosts

# FastAPI -> Jetson host
JETSON_PORT=22
JETSON_USER=jetson
JETSON_WORKSPACE=/home/jetson/BRIN RI NDIP
DETECTION_PYTHON=/home/jetson/yolo-env/bin/python

# Camera
CAMERA_IP=10.21.20.52
CAMERA_CONFIG_FILE=Mobil_Pos.py
CAMERA_FRAME_CACHE=/home/jetson/.cache/brin-edge/camera-frame.jpg
CAMERA_LIVE_CHANNEL=101
CAMERA_MAX_LIVE_VIEWERS=4

# Firebase Authentication
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_ADMIN_EMAIL=replace-with-firebase-login-email
AUTH_USERNAME=admin

# Keep false for the first HTTP/Tailnet trial. Change to true only after HTTPS works.
AUTH_COOKIE_SECURE=false
API_DOCS_ENABLED=false
